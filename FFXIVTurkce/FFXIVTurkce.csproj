<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>Mustafa</Author>
    <Name>FFXIV Türkçe</Name>
    <Punchline>NPC diyaloglarını anında Türkçeye çevirir (overlay).</Punchline>
    <Description>Talk / BattleTalk diyaloglarını Gemini veya Claude ile Türkçeye çevirip oyunun diyalog kutusunun üstünde overlay olarak gösterir. Çeviriler önbelleğe alınır.</Description>
    <RepoUrl>https://github.com/KULLANICI_ADI/FFXIVTurkce</RepoUrl>
    <Tags>translation;turkish;türkçe;dialogue</Tags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="*" />
  </ItemGroup>
</Project>
